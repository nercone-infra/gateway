# RucoNet (docker compose run --rm ruconet ruconet-hub keygen <name> in the ruconet repository)
RUCONET_PRIVATE_KEY=
RUCONET_PRESHARED_KEY=
RUCONET_HUB_PUBLIC_KEY=

# Destinations RucoNet members must not reach through the egress, separated by spaces
# (empty: special-purpose and private IPv4 ranges; add the public addresses of this host when overriding)
EGRESS_DENY=
